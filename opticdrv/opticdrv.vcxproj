<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{6B1C2C58-2E5A-4C77-9D3B-0F6B7C1A5D10}</ProjectGuid>
    <TemplateGuid>{497e31cb-056b-4f31-abb8-447fd55ee5a5}</TemplateGuid>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>12.0</MinimumVisualStudioVersion>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RootNamespace>opticdrv</RootNamespace>
    <WindowsTargetPlatformVersion>$(LatestTargetPlatformVersion)</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetName>opticdrv</TargetName>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <!-- Desktop, not Universal: this is a classic kernel service loaded through the SCM, not a DCH
         driver. Universal makes the WDK run ApiValidator, which rejects wdmsec.lib (used for the
         device ACL) because it is not on the Universal DDI allow-list. -->
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <TargetVersion>Windows10</TargetVersion>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- The driver is loaded as a plain kernel service by `optic install`; no INF, no catalog. -->
    <EnableInf2cat>false</EnableInf2cat>
    <SignMode>Off</SignMode>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <!-- Warnings are shown but do not fail the build: this driver was written without a WDK to
           compile against. Turn this back on once it builds clean in CI. -->
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <Link>
      <!-- Required for PsSetCreateProcessNotifyRoutineEx to accept the callback. -->
      <AdditionalOptions>/INTEGRITYCHECK %(AdditionalOptions)</AdditionalOptions>
      <!-- Defines SDDL_DEVOBJ_SYS_ALL_ADM_ALL, used to restrict the control device to SYSTEM and
           Administrators. wdmsec.h only declares it. -->
      <AdditionalDependencies>wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="opticdrv.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="ioctl.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
