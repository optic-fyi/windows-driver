<Project>
  <!--
    Use the WDK/SDK restored by `nuget restore packages.config -PackagesDirectory packages` when
    present. Without the restored packages these imports are skipped and the build falls back to an
    installed WDK, so a developer machine with the WDK MSI needs no restore.
    Keep the version in sync with packages.config.
  -->
  <PropertyGroup>
    <OpticWdkVersion>10.0.28000.2526</OpticWdkVersion>
    <OpticPackages>$(MSBuildThisFileDirectory)packages\</OpticPackages>
  </PropertyGroup>
  <Import Project="$(OpticPackages)Microsoft.Windows.WDK.x64.$(OpticWdkVersion)\build\native\Microsoft.Windows.WDK.x64.props"
          Condition="Exists('$(OpticPackages)Microsoft.Windows.WDK.x64.$(OpticWdkVersion)\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(OpticPackages)Microsoft.Windows.SDK.CPP.x64.$(OpticWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props"
          Condition="Exists('$(OpticPackages)Microsoft.Windows.SDK.CPP.x64.$(OpticWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(OpticPackages)Microsoft.Windows.SDK.CPP.$(OpticWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.props"
          Condition="Exists('$(OpticPackages)Microsoft.Windows.SDK.CPP.$(OpticWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.props')" />
</Project>
