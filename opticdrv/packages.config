<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows Driver Kit headers and libraries, restored from NuGet so CI does not need the WDK MSI.
  Same packages and mechanism as microsoft/Windows-driver-samples (packages.config + nuget restore),
  pinned to 10.0.28000.x, which ships the Visual Studio 2026 (MSBuild 18.0) driver build tasks that the windows-latest runner uses.
  Keep the version in sync with Directory.Build.props.
-->
<packages>
  <package id="Microsoft.Windows.SDK.CPP" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.x64" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.x64" version="10.0.28000.2526" targetFramework="native" />
</packages>
